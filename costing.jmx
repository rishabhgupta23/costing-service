          <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 Assertion" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

def responseText = prev.getResponseDataAsString().trim()
def jsonResponse = new JsonSlurper().parseText(responseText)

def vendorNames = jsonResponse.data.collect { it.name }

def invalidVendors = vendorNames.findAll { !it.toLowerCase().contains(&quot;com&quot;) }

assert invalidVendors.isEmpty() : &quot;❌ Test Failed! Found invalid partNames: &quot; + invalidVendors
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Assertion>
