          <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

// Parse response text
def responseText = prev.getResponseDataAsString().trim()
def jsonResponse = new JsonSlurper().parseText(responseText)

// Extract all cost factor names
def costFactorNames = jsonResponse.data.collect { it.name }

// Define your filter keyword
def filterKeyword = &quot;a&quot;

// Validate each name contains the filter keyword (case-insensitive)
def invalidFactors = costFactorNames.findAll { !it.toLowerCase().contains(filterKeyword) }

// Fail test if any name doesn&apos;t match filter
assert invalidFactors.isEmpty() : &quot;❌ Test Failed! Found invalid factor names: ${invalidFactors}&quot;
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223Listener>
